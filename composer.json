{
    "name": "roundly-consulting/appointments-for-laravel",
    "description": "Laravel package to manage appointments between entities.",
    "keywords": [
        "Roundly Consulting",
        "laravel",
        "appointments"
    ],
    "homepage": "https://github.com/roundly-consulting/appointments-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "info@mihaliak.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Appointments\\": "src",
            "RoundlyConsulting\\Appointments\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Appointments\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Appointments\\AppointmentsServiceProvider"
            ],
            "aliases": {
                "Appointments": "RoundlyConsulting\\Appointments\\Facades\\Appointments"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
